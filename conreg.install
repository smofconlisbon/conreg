        'not null' => TRUE,
        'default' => 0.0,
        'description' => 'Total amount received for all members in group.',
      ],
      // Alter table conreg_member_addons add payid int after addon_amount;.
      'payid' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Compound Primary Key: Member ID.',
      ],
      'is_paid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'size' => 'tiny',
        'description' => 'Set to 1 if payment complete.',
      ],
      'payment_ref' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'default' => '',
        'description' => 'Payment confirmation code from Stripe or other payment system.',
      ],
    ],
    'primary key' => ['addonid'],
  ];

  // Create table conreg_member_clickup_options (mid int not null, option_group
  // varchar(32) NOT NULL, clickup_task_id varchar(255) NOT NULL, update_date
  // int NOT NULL, primary key (mid, option_group));.
  $schema['conreg_member_clickup_options'] = [
    'description' => 'Stores member click-up task IDs.',
    'fields' => [
      'mid' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Compound Primary Key: Member ID.',
      ],
      'option_group' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Group of options sharing a single task.',
      ],
      'clickup_task_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Task ID returned from ClickUp.',
      ],
      'update_date' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp for the date and time last updated.',
      ],
    ],
    'primary key' => ['mid', 'option_group'],
  ];

  return $schema;
}

/**
 * Remove any "reference.countries" from settings.
 */
function conreg_update_9001() {
  foreach (\Drupal::configFactory()->listAll('conreg.settings') as $key) {
    $config = \Drupal::configFactory()->getEditable($key);
    $config->clear("reference.countries");
    $config->save();
  }
}

/**
 * Add language field to conreg_members.
 */
function conreg_update_9002() {
  $spec = [
    'type' => 'varchar',
    'description' => "Member language",
    'length' => 2,
    'not null' => TRUE,
    'initial' => 'en',
  ];
  $schema = Database::getConnection()->schema();
  $schema->addField('conreg_members', 'language', $spec);
}

/**
 * Add payment sessions table.
 *
 * Move Stripe session ID from payments table to payment sessions. Drop session
 * ID from payments table.
 */
function conreg_update_9003() {
  $conreg_payment_sessions = [
    'description' => 'Stores member upgrades.',
    'fields' => [
      'paysessionid' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique payment session ID.',
      ],
      'payid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => "Payment ID that the session belongs to.",
      ],
      'session_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'default' => '',
        'description' => 'Stripe Session ID.',
      ],
    ],
    'primary key' => ['paysessionid'],
  ];
  $db = Database::getConnection();
  $schema = $db->schema();
  $schema->createTable('conreg_payment_sessions', $conreg_payment_sessions);
  $db->query('INSERT INTO {conreg_payment_sessions} (payid, session_id) SELECT payid, session_id FROM {conreg_payments}');
  $schema->dropField('conreg_payments', 'session_id');
}

/**
 * Add indexes to payment sessions table.
 */
function conreg_update_9004() {
  $conreg_payment_sessions = [
    'description' => 'Stores member upgrades.',
    'fields' => [
      'paysessionid' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary Key: Unique payment session ID.',
      ],
      'payid' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => "Payment ID that the session belongs to.",
      ],
      'session_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'default' => '',
        'description' => 'Stripe Session ID.',
      ],
    ],
    'primary key' => ['paysessionid'],
    'indexes' => [
      'idx_conreg_payment_sessions_payid' => ['payid'],
      'idx_conreg_payment_sessions_session_id' => ['session_id'],
    ],
  ];

  $db = Database::getConnection();
  $schema = $db->schema();
  $schema->addIndex('conreg_payment_sessions', 'idx_conreg_payment_sessions_payid', ['payid'], $conreg_payment_sessions);
  $schema->addIndex('conreg_payment_sessions', 'idx_conreg_payment_sessions_session_id', ['session_id'], $conreg_payment_sessions);
}

/**
 * Combine add-on labels and descriptions and add the free amount flag.
 */
function conreg_update_9005() {
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('conreg.settings.') as $config_name) {
    $config = $config_factory->getEditable($config_name);
    $add_ons = $config->get('add-ons');
    if (!is_array($add_ons)) {
      continue;
    }

    foreach ($add_ons as &$add_on) {
      $add_on['addon'] ??= [];
      $free = $add_on['free'] ?? [];
      $free_label = trim((string) ($free['label'] ?? ''));
      $add_on['addon']['free'] = $free_label !== '';

      if ($add_on['addon']['free']) {
        $add_on['addon']['label'] = $free_label;
        $add_on['addon']['description'] = $free['description'] ?? '';
      }

      unset($add_on['free']);
    }
    unset($add_on);

    $config->set('add-ons', $add_ons)->save();
  }
}

/**
 * Remove plaintext Stripe keys from config now that Key module is used.
 */
function conreg_update_9006() {
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('conreg.settings.') as $config_name) {
    $config = $config_factory->getEditable($config_name);
    if (empty($config->get('payments.public_key')) && empty($config->get('payments.private_key'))) {
      continue;
    }

    // Blank out the plaintext keys rather than leaving them in config,
    // where they could be exported and leaked. Site admins must create Key
    // entities for their existing Stripe keys and reselect them on the
    // event's Payment System tab.
    $config->set('payments.public_key', '')
      ->set('payments.private_key', '')
      ->save();
  }
}

/**
 * Install the Token module, now a dependency for the token browser links.
 */
function conreg_update_9007() {
  \Drupal::service('module_installer')->install(['token']);
}

/**
 * Install Easy Email, now a dependency for translatable email templates.
 */
function conreg_update_9008() {
  \Drupal::service('module_installer')->install(['easy_email']);
}

/**
 * Migrate member-check email templates into Easy Email templates.
 *
 * One EasyEmailType per distinct existing subject/body/format found across
 * events, so no event-specific wording is lost - events sharing identical
 * text end up sharing a template. member_check.confirm_subject has always
 * doubled as the "unknown" email's subject too (there was never a separate
 * unknown_subject key), so that behavior is preserved as each new
 * template's own subject.
 */
function conreg_update_9009() {
  $config_factory = \Drupal::configFactory();
  $email_type_storage = \Drupal::entityTypeManager()->getStorage('easy_email_type');
  $confirmIds = [];
  $unknownIds = [];

  foreach ($config_factory->listAll('conreg.settings.') as $config_name) {
    $eid = substr($config_name, strlen('conreg.settings.'));
    $config = $config_factory->getEditable($config_name);

    $subject = (string) $config->get('member_check.confirm_subject');
    $confirmBody = (string) $config->get('member_check.confirm_body');
    $confirmFormat = (string) ($config->get('member_check.confirm_format') ?: 'basic_html');
    $unknownBody = (string) $config->get('member_check.unknown_body');
    $unknownFormat = (string) ($config->get('member_check.unknown_format') ?: 'basic_html');

    // 'conreg_mcheck_confirm_'/'conreg_mcheck_unknown_' rather than the
    // fuller 'conreg_member_check_*' - easy_email_type IDs are bundle IDs,
    // capped at 32 characters (EntityTypeInterface::BUNDLE_MAX_LENGTH).
    $confirmHash = md5($subject . '|' . $confirmBody . '|' . $confirmFormat);
    if (!isset($confirmIds[$confirmHash])) {
      $id = 'conreg_mcheck_confirm_' . $eid;
      $email_type_storage->create([
        'id' => $id,
        'label' => 'ConReg: member found (event ' . $eid . ')',
        'subject' => $subject,
        // full_html, not the migrated $confirmFormat: the old format value
        // was only ever used to pick the admin's CKEditor toolbar -
        // ConregEmailer rendered the body via Markup::create(), bypassing
        // Drupal's text filter system entirely, so it was never actually
        // enforced. Easy Email does enforce it (via #type => processed_text),
        // and 'basic_html''s allowed-tags list strips <table>/<tr>/<td>
        // and the inline styles MemberDetailsFormatter relies on.
        'bodyHtml' => ['value' => $confirmBody, 'format' => 'full_html'],
        'generateBodyPlain' => FALSE,
      ])->save();
      $confirmIds[$confirmHash] = $id;
    }

    $unknownHash = md5($subject . '|' . $unknownBody . '|' . $unknownFormat);
    if (!isset($unknownIds[$unknownHash])) {
      $id = 'conreg_mcheck_unknown_' . $eid;
      $email_type_storage->create([
        'id' => $id,
        'label' => 'ConReg: member not found (event ' . $eid . ')',
        'subject' => $subject,
        'bodyHtml' => ['value' => $unknownBody, 'format' => 'full_html'],
        'generateBodyPlain' => FALSE,
      ])->save();
      $unknownIds[$unknownHash] = $id;
    }

    $config->set('member_check.confirm_easy_email_type', $confirmIds[$confirmHash]);
    $config->set('member_check.unknown_easy_email_type', $unknownIds[$unknownHash]);
    $config->clear('member_check.confirm_subject');
    $config->clear('member_check.confirm_body');
    $config->clear('member_check.confirm_format');
    $config->clear('member_check.unknown_body');
    $config->clear('member_check.unknown_format');
    $config->save();
  }

  return t('Migrated member-check email templates to Easy Email templates. Review them under /admin/structure/email-templates and re-enter any translations that were previously set via Config Translation on the old fields - translations do not migrate automatically.');
}

/**
 * Migrate confirmation/bulk-email templates into Easy Email templates.
 *
 * Confirmation, bulk_email, and each member type's confirmation override
 * all draw from the same 'conreg_registration_*' bundle family (per the
 * project owner's instruction that these three should share templates),
 * deduped by exact text so distinct existing wording still gets its own
 * bundle rather than being silently collapsed or discarded.
 */
function conreg_update_9010() {
  $config_factory = \Drupal::configFactory();
  $email_type_storage = \Drupal::entityTypeManager()->getStorage('easy_email_type');
  $ids = [];

  $createOrReuse = function (string $subject, string $body, string $format, string $id, string $label) use (&$ids, $email_type_storage) {
    $hash = md5($subject . '|' . $body . '|' . $format);
    if (!isset($ids[$hash])) {
      // easy_email_type IDs are bundle IDs, capped at 32 characters
      // (EntityTypeInterface::BUNDLE_MAX_LENGTH) - fall back to a
      // hash-suffixed ID if a member-type code makes it too long.
      if (strlen($id) > 32) {
        $id = substr($id, 0, 24) . '_' . substr(md5($id), 0, 7);
      }
      $email_type_storage->create([
        'id' => $id,
        'label' => $label,
        'subject' => $subject,
        // full_html, not the migrated $format: the old format value was
        // only ever used to pick the admin's CKEditor toolbar -
        // ConregEmailer rendered via Markup::create(), bypassing Drupal's
        // text filter system entirely, so it was never actually enforced.
        // Easy Email does enforce it, and 'basic_html''s allowed-tags list
        // strips <table>/<tr>/<td> and the inline styles
        // MemberDetailsFormatter relies on.
        'bodyHtml' => ['value' => $body, 'format' => 'full_html'],
        'generateBodyPlain' => FALSE,
      ])->save();
      $ids[$hash] = $id;
    }
    return $ids[$hash];
  };

  foreach ($config_factory->listAll('conreg.settings.') as $config_name) {
    $eid = substr($config_name, strlen('conreg.settings.'));
    $config = $config_factory->getEditable($config_name);

    $subject = (string) $config->get('confirmation.template_subject');
    $body = (string) $config->get('confirmation.template_body');
    $format = (string) $config->get('confirmation.template_format');
    $bundle = $createOrReuse($subject, $body, $format, 'conreg_registration_' . $eid, 'ConReg: registration (event ' . $eid . ')');
    $config->set('confirmation.easy_email_type', $bundle);
    $config->clear('confirmation.template_subject');
    $config->clear('confirmation.template_body');
    $config->clear('confirmation.template_format');
    $config->clear('confirmation.format_html');

    // Bulk email only gets its own bundle if its text actually differs
    // (or was set at all) - otherwise it's left to fall back to the
    // confirmation bundle, which the admin UI defaults new selections to.
    $bulkSubject = (string) $config->get('bulk_email.template_subject');
    $bulkBody = (string) $config->get('bulk_email.template_body');
    if ($bulkSubject !== '' || $bulkBody !== '') {
      $bulkFormat = (string) $config->get('bulk_email.template_format');
      $bulkBundle = $createOrReuse($bulkSubject, $bulkBody, $bulkFormat, 'conreg_registration_' . $eid . '_bulk', 'ConReg: bulk email (event ' . $eid . ')');
      $config->set('bulk_email.easy_email_type', $bulkBundle);
    }
    $config->clear('bulk_email.template_subject');
    $config->clear('bulk_email.template_body');
    $config->clear('bulk_email.template_format');

    foreach (array_keys($config->get('member.types') ?? []) as $typeCode) {
      if (empty($config->get("member.types.$typeCode.confirmation.override"))) {
        $config->clear("member.types.$typeCode.confirmation.template_subject");
        $config->clear("member.types.$typeCode.confirmation.template_body");
        $config->clear("member.types.$typeCode.confirmation.template_format");
        $config->clear("member.types.$typeCode.confirmation.override");
        continue;
      }
      $typeSubject = (string) $config->get("member.types.$typeCode.confirmation.template_subject");
      $typeBody = (string) $config->get("member.types.$typeCode.confirmation.template_body");
      $typeFormat = (string) $config->get("member.types.$typeCode.confirmation.template_format");
      $typeBundle = $createOrReuse($typeSubject, $typeBody, $typeFormat, 'conreg_registration_' . $eid . '_' . $typeCode, 'ConReg: registration (event ' . $eid . ', type ' . $typeCode . ')');
      $config->set("member.types.$typeCode.confirmation.easy_email_type", $typeBundle);
      $config->clear("member.types.$typeCode.confirmation.template_subject");
      $config->clear("member.types.$typeCode.confirmation.template_body");
      $config->clear("member.types.$typeCode.confirmation.template_format");
      $config->clear("member.types.$typeCode.confirmation.override");
    }

    $config->save();
  }

  return t('Migrated confirmation/bulk-email templates to Easy Email templates. Review them under /admin/structure/email-templates and re-enter any translations that were previously set via Config Translation on the old fields - translations do not migrate automatically.');
}

/**
 * Turn off "Generate plain text body" on conreg's Easy Email templates.
 *
 * Easy Email's own HTML-to-text auto-conversion runs on the final
 * rendered HTML, after tokens resolve - by then [conreg:member-details]
 * has become an HTML <table>, which generic HTML-to-text converters don't
 * add row/cell separators to, so the member details table renders as one
 * run-on line. ConregEmailSender::populatePlainBody() now sets a proper
 * plain-text body itself (using the 'plain_text' token option
 * ConregTokenHooks already supports), but only takes effect if the
 * template isn't set to auto-generate one - conreg_update_9009/9010
 * created these templates before that fix existed, so flip the flag on
 * whatever they already created.
 */
function conreg_update_9011() {
  $email_type_storage = \Drupal::entityTypeManager()->getStorage('easy_email_type');
  $prefixes = ['conreg_registration_', 'conreg_mcheck_confirm_', 'conreg_mcheck_unknown_'];
  $updated = [];

  /** @var \Drupal\easy_email\Entity\EasyEmailTypeInterface $type */
  foreach ($email_type_storage->loadMultiple() as $id => $type) {
    foreach ($prefixes as $prefix) {
      if (str_starts_with($id, $prefix) && $type->getGenerateBodyPlain()) {
        $type->setGenerateBodyPlain(FALSE)->save();
        $updated[] = $id;
        break;
      }
    }
  }

  return t('Turned off "Generate plain text body" on: @ids', ['@ids' => implode(', ', $updated) ?: '(none found)']);
}

/**
 * Switch conreg's Easy Email templates from basic_html to full_html.
 *
 * Easy Email renders body_html through Drupal's text filter system
 * (#type => processed_text), unlike ConregEmailer, which rendered via
 * Markup::create() and so never actually applied the configured format's
 * filters. 'basic_html''s allowed-tags list doesn't include <table>/<tr>/
 * <td>/<th> or the style attribute, so [conreg:member-details]'s table
 * was being silently stripped down to run-on text - conreg_update_9009/
 * 9010 created these templates with the (never-enforced) migrated format
 * value before this was discovered, so fix up whatever they created.
 * Templates are admin-authored, trusted content, so full_html (no tag
 * restriction) is appropriate here.
 */
function conreg_update_9012() {
  $email_type_storage = \Drupal::entityTypeManager()->getStorage('easy_email_type');
  $prefixes = ['conreg_registration_', 'conreg_mcheck_confirm_', 'conreg_mcheck_unknown_'];
  $updated = [];

  /** @var \Drupal\easy_email\Entity\EasyEmailTypeInterface $type */
  foreach ($email_type_storage->loadMultiple() as $id => $type) {
    foreach ($prefixes as $prefix) {
      if (!str_starts_with($id, $prefix)) {
        continue;
      }
      $body = $type->getBodyHtml();
      if (($body['format'] ?? NULL) !== 'full_html') {
        $body['format'] = 'full_html';
        $type->setBodyHtml($body)->save();
        $updated[] = $id;
      }
      break;
    }
  }

  return t('Switched to the full_html format on: @ids', ['@ids' => implode(', ', $updated) ?: '(none found)']);
}

/**
 * Installs storage for conreg's base fields on the easy_email entity type.
 *
 * Field_conreg_eid/field_conreg_mid/field_conreg_extra_token_data are
 * declared by conreg (ConregEasyEmailFieldHooks::entityBaseFieldInfo()),
 * not by easy_email itself. Installing the easy_email module within the
 * same request as conreg_update_9008 didn't pick these up, so their
 * storage was never actually created - saving any easy_email entity
 * fails with a missing-table SQLSTATE error the first time something
 * saves one (e.g. the "email a member" admin form, via
 * EmailHandlerInterface::sendEmail(..., $save_email_entity = TRUE)).
 */
function conreg_update_9013() {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $fieldManager = \Drupal::service('entity_field.manager');
  $storageDefinitions = $fieldManager->getFieldStorageDefinitions('easy_email');

  foreach (['field_conreg_eid', 'field_conreg_mid', 'field_conreg_extra_token_data'] as $fieldName) {
    if ($updateManager->getFieldStorageDefinition($fieldName, 'easy_email')) {
      // Already installed.
      continue;
    }
    $updateManager->installFieldStorageDefinition($fieldName, 'easy_email', 'conreg', $storageDefinitions[$fieldName]);
  }
}

/**
 * Migrate the old canned "email a member" templates and remove the config.
 *
 * Conreg.email_templates (edited via the now-removed EmailTemplates admin
 * form) stored an ad hoc numbered list of templates (template1subject,
 * template1body, ... up to 'count') used only as a picklist in the
 * "email a member" admin form, which now selects an easy_email_type
 * directly instead. Each existing template becomes its own
 * conreg_registration_adhoc_<n> bundle so no existing wording is lost,
 * and the old config is deleted since nothing reads it any more.
 */
function conreg_update_9014() {
  $config = \Drupal::configFactory()->getEditable('conreg.email_templates');
  if ($config->isNew()) {
    return t('No conreg.email_templates config found - nothing to migrate.');
  }

  $email_type_storage = \Drupal::entityTypeManager()->getStorage('easy_email_type');
  $count = (int) ($config->get('count') ?: 0);
  $created = [];

  for ($template = 1; $template <= $count; $template++) {
    $subject = (string) $config->get('template' . $template . 'subject');
    $body = (string) $config->get('template' . $template . 'body');
    if ($subject === '' && $body === '') {
      continue;
    }
    $id = 'conreg_registration_adhoc_' . $template;
    $email_type_storage->create([
      'id' => $id,
      'label' => 'ConReg: ad hoc template ' . $template,
      'subject' => $subject,
      'bodyHtml' => ['value' => $body, 'format' => 'full_html'],
      'generateBodyPlain' => FALSE,
    ])->save();
    $created[] = $id;
  }

  $config->delete();

  return t('Migrated the old canned email templates to Easy Email templates: @ids. Review them under /admin/structure/email-templates and re-enter any translations that were previously set via Config Translation on the old fields - translations do not migrate automatically.', [
    '@ids' => implode(', ', $created) ?: '(none found)',
  ]);
}

/**
 * Install the conreg_printer and conreg_print_job entity types.
 */
function conreg_update_9015() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type_manager = \Drupal::entityTypeManager();

  $update_manager->installEntityType($entity_type_manager->getDefinition('conreg_printer'));
  $update_manager->installEntityType($entity_type_manager->getDefinition('conreg_print_job'));
}

/**
 * Add the machine_name field to the conreg_printer entity type.
 */
function conreg_update_9016() {
  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Machine name'))
    ->setDescription(t('A stable, CUPS-safe identifier (e.g. "bilbo_baggins") matching the print agent\'s CUPS queue name. Sent over the API and matched against the --printer argument the agent polls with; never shown to staff.'))
    ->setRequired(TRUE)
    ->setSetting('max_length', 64);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('machine_name', 'conreg_printer', 'conreg', $storage_definition);
}

/**
 * Adds the badge_type field to the conreg_print_job entity type.
 */
function conreg_update_9017() {
  $storage_definition = BaseFieldDefinition::create('string')
    ->setLabel(t('Badge type'))
    ->setDescription(t("The member's badge type, snapshotted at job creation time."))
    ->setSetting('max_length', 64);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('badge_type', 'conreg_print_job', 'conreg', $storage_definition);
}

/**
 * Seeds the default label sizes and label printing settings.
 *
 * Config/install only auto-imports on a fresh module install, so sites
 * that already had conreg enabled before badge label printing settings
 * were added would otherwise be left with an empty label size list and
 * an unconfigured settings endpoint.
 */
function conreg_update_9018() {
  $labelSizeStorage = \Drupal::entityTypeManager()->getStorage('conreg_label_size');

  $sizes = [
    'standard_address' => [
      'label' => 'Standard Address (28 x 89mm)',
      'width_mm' => 28,
      'height_mm' => 89,
      'rotate_degrees' => 90,
    ],
    'large_address' => [
      'label' => 'Large Address (36 x 89mm)',
      'width_mm' => 36,
      'height_mm' => 89,
      'rotate_degrees' => 90,
    ],
  ];

  $created = [];
  foreach ($sizes as $id => $values) {
    if ($labelSizeStorage->load($id)) {
      continue;
    }
    $labelSizeStorage->create(['id' => $id] + $values)->save();
    $created[] = $id;
  }

  $config = \Drupal::configFactory()->getEditable('conreg.label_printing.settings');
  if ($config->isNew()) {
    $config
      ->set('label_size', 'standard_address')
      ->set('copies', 1)
      ->set('name_lines', 2)
      ->set('suppress_printing', FALSE)
      ->set('field_positions', [
        'badge_name' => 'middle',
        'member_number' => 'bottom_left',
        'days_attending' => 'bottom_right',
        'badge_type' => 'none',
      ])
      ->save();
  }

  return t('Created default label sizes: @sizes.', [
    '@sizes' => implode(', ', $created) ?: '(none - already present)',
  ]);
}

/**
 * Adds the image_data field to the conreg_print_job entity type.
 *
 * Rendering moved from the print agent into ConReg itself, so every
 * job now snapshots its own rendered (unrotated) label image at
 * creation time - see \Drupal\conreg\Service\LabelRenderer.
 */
function conreg_update_9019() {
  $storage_definition = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Rendered label image'))
    ->setDescription(t('Base64-encoded PNG of the rendered (unrotated) label, snapshotted at job creation time.'));

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('image_data', 'conreg_print_job', 'conreg', $storage_definition);
}

/**
 * Adds the last_seen field to the conreg_printer entity type.
 *
 * Lets the admin UI show whether a printer's agent is actually online.
 */
function conreg_update_9020() {
  $storage_definition = BaseFieldDefinition::create('timestamp')
    ->setLabel(t('Last seen'))
    ->setDescription(t("When this printer's agent last successfully polled for jobs - the poll itself is the heartbeat signal."));

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('last_seen', 'conreg_printer', 'conreg', $storage_definition);
}

/**
 * Backfills the retention_days default onto existing label printing settings.
 *
 * Config/install only auto-imports on a fresh module install, so a site
 * that already had conreg.label_printing.settings (from update 9018)
 * before this setting was added would otherwise have it missing until
 * someone happened to resave the settings form. Reading code already
 * falls back to 30 when it's absent, but the active config should
 * reflect that explicitly rather than relying on incidental self-healing.
 */
function conreg_update_9021() {
  $config = \Drupal::configFactory()->getEditable('conreg.label_printing.settings');
  if (!$config->isNew() && $config->get('retention_days') === NULL) {
    $config->set('retention_days', 30)->save();
  }
}

/**
 * Adds the is_test field to the conreg_print_job entity type.
 *
 * Marks jobs created by the Label Printing Settings page's "Test
 * print" button (which have no real member, unlike a check-in job) so
 * they can be told apart later. The mid field's "required" constraint
 * was also relaxed for the same reason - it's a validation-only
 * change, not a schema one (the column was already nullable), so it
 * needs no field storage update here.
 */
function conreg_update_9022() {
  $storage_definition = BaseFieldDefinition::create('boolean')
    ->setLabel(t('Test print'))
    ->setDescription(t('Set for jobs created by the Label Printing Settings page\'s "Test print" button, so they can be told apart from real check-in jobs.'))
    ->setDefaultValue(FALSE);

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('is_test', 'conreg_print_job', 'conreg', $storage_definition);
}

/**
 * Grants "reprint convention member badge label" alongside "undo check-in".
 *
 * "Reprint label" used to be gated on "undo convention member
 * check-in" (there was no separate permission). Now that it has its
 * own "reprint convention member badge label" permission, any role
 * that already had the undo permission needs this one granted too, or
 * sites upgrading would silently lose the ability to reprint labels
 * that worked before this update.
 */
function conreg_update_9023() {
  foreach (Role::loadMultiple() as $role) {
    if ($role->hasPermission('undo convention member check-in') && !$role->hasPermission('reprint convention member badge label')) {
      $role->grantPermission('reprint convention member badge label')->save();
    }
  }
}

/**
 * Converts line-delimited textarea config strings to arrays.
 *
 * Several "one item per line" settings (member upgrades, badge types,
 * days, etc.) used to be stored as a single CRLF/LF-delimited string.
 * Browsers always submit textarea content with CRLF line endings, and not
 * every place that read these values back stripped the trailing carriage
 * return, so it could leak into the last field on a line (e.g. a price or
 * a ClickUp member ID). Storing each line as its own array element removes
 * the problem at the source.
 */
function conreg_update_9024() {
  $config_factory = \Drupal::configFactory();

  // Top-level dotted-path keys that moved from a CRLF-delimited string to a
  // sequence of trimmed lines, per event config object.
  $simple_keys = [
    'member_upgrades',
    'badge_types',
    'badge_name_options',
    'days',
    'communications_method.options',
    'display_options.options',
    'conreg_options.option_groups',
    'conreg_options.options',
  ];

  foreach ($config_factory->listAll('conreg.settings.') as $config_name) {
    $config = $config_factory->getEditable($config_name);
    $changed = FALSE;

    foreach ($simple_keys as $key) {
      $value = $config->get($key);
      // Idempotent: skip NULL/missing and already-array (already migrated).
      if ($value === NULL || is_array($value)) {
        continue;
      }
      $config->set($key, TextareaLines::toArray($value));
      $changed = TRUE;
    }

    // clickup_option_groups.<name>.option_mapping lives in this same config
    // object when the conreg_clickup submodule is in use.
    $groups = $config->get('clickup_option_groups');
    if (is_array($groups)) {
      foreach ($groups as $group_name => $group) {
        $mapping = $group['option_mapping'] ?? NULL;
        if ($mapping !== NULL && !is_array($mapping)) {
          $config->set(
            'clickup_option_groups.' . $group_name . '.option_mapping',
            TextareaLines::toArray($mapping)
          );
          $changed = TRUE;
        }
      }
    }

    if ($changed) {
      $config->save();
    }
  }
}
