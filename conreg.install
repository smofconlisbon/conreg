<?php

/**
 * @file
 * Install file for Conreg. Install database schema.
 */

// cspell:ignore unconfigured
use Drupal\conreg\TextareaLines;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Database\Database;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\user\Entity\Role;

/**
 * Implements hook_requirements().
 */
function conreg_requirements($phase) {
  $requirements = [];
  if ($phase == 'install') {
    if (!class_exists('\Stripe\Stripe')) {
      $requirements['addressing_library'] = [
        'description' => t('ConReg requires the stripe/stripe-php library. Please see README for install instructions.'),
        'severity' => RequirementSeverity::Error,
      ];
    }
  }

  return $requirements;
}

/**
 * Implements hook_install().
 */
function conreg_install() {
  $database = \Drupal::database();

  // Only create a default event if none exist.
  $exists = $database->select('conreg_events', 'e')
    ->fields('e', ['eid'])
    ->range(0, 1)
    ->execute()
    ->fetchField();

  if (!$exists) {
    $database->insert('conreg_events')
      ->fields([
        'event_name' => 'Default event',
        'is_open' => 1,
      ])
      ->execute();
  }
}

