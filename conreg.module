<?php

/**
 * @file
 * Module file for ConReg.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\conreg\ConregConfig;
use Drupal\conreg\Hook\ConregHooks;
use Drupal\conreg\Hook\ConregThemeHooks;
use Drupal\conreg\Hook\ConregTokenHooks;
use Drupal\conreg\Member;
use Drupal\conreg\Service\EventStorage;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function conreg_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(ConregHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function conreg_page_attachments(&$variables) {
  \Drupal::service(ConregHooks::class)->pageAttachments($variables);
}

/**
 * Implements hook_user_login().
 */
function conreg_user_login(UserInterface $account) {
  $email = $account->getEmail();
  if (is_null($email)) {
    // User is anonymous, so no permissions to add.
  }
  /** @var \Drupal\conreg\Service\EventStorage $event_storage */
  $event_storage = \Drupal::service(EventStorage::class);
  // Get the list of all events.
  $events = $event_storage->loadAll();
  foreach ($events as $event) {
    $eid = $event['eid'];
    $config = ConregConfig::getConfig($eid);
    // Get the role for the event.
    $add_role = $config->get('member_portal.add_role');
    if ($add_role) {
      // Check if user has role already.
      if (!$account->hasRole($add_role)) {
        // Check if account is member of event.
        $member = Member::loadMemberByEmail($eid, $email);
        if (!is_null($member)) {
          // They don't, so we need to add it.
          $account->addRole($add_role);
          $account->save();
        }
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function conreg_theme(): array {
  return \Drupal::service(ConregThemeHooks::class)->theme();
}

/**
 * Implements hook_preprocess_HOOK() for member_type_cards.
 */
#[LegacyHook]
function conreg_preprocess_member_type_cards(array &$variables): void {
  \Drupal::service(ConregThemeHooks::class)->preprocessMemberTypeCards($variables);
}

/**
 * Implements hook_preprocess_HOOK() for member_day_options.
 */
#[LegacyHook]
function conreg_preprocess_member_day_options(array &$variables): void {
  \Drupal::service(ConregThemeHooks::class)->preprocessMemberDayOptions($variables);
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function conreg_token_info() {
  return \Drupal::service(ConregTokenHooks::class)->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function conreg_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  return \Drupal::service(ConregTokenHooks::class)->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}
